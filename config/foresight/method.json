      "3": {"fr": "Significatif", "en": "Significant", "d_fr": "Un site ou une chaîne perturbé plusieurs jours, surcoûts sensibles.", "d_en": "A site or supply chain disrupted for several days, noticeable extra costs."},
      "4": {"fr": "Majeur", "en": "Major", "d_fr": "Arrêt partiel, atteinte durable aux approvisionnements ou aux marges.", "d_en": "Partial shutdown, lasting damage to supply or margins."},
      "5": {"fr": "Critique", "en": "Critical", "d_fr": "Arrêt d'activité, atteinte aux personnes ou crise systémique.", "d_en": "Shutdown, harm to people or systemic crisis."}
    },
    "impact_travel": {
      "1": {"fr": "Négligeable", "en": "Negligible", "d_fr": "Aucun effet sur les déplacements.", "d_en": "No effect on travel."},
