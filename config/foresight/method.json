      "2": {"fr": "Possible", "en": "Possible", "p": "20–40 %", "d_fr": "Signaux faibles ou isolés.", "d_en": "Weak or isolated signals."},
      "3": {"fr": "Possibilité réelle", "en": "Realistic possibility", "p": "40–55 %", "d_fr": "Signaux concordants, issue encore ouverte.", "d_en": "Consistent signals, outcome still open."},
      "4": {"fr": "Probable", "en": "Likely", "p": "55–80 %", "d_fr": "Dynamique engagée, plusieurs sources indépendantes la confirment.", "d_en": "Dynamic under way, confirmed by several independent sources."},
      "5": {"fr": "Très probable", "en": "Highly likely", "p": "> 80 %", "d_fr": "Tendance déjà observée ou récurrente (saisonnière, structurelle).", "d_en": "Trend already observed or recurring (seasonal, structural)."}
