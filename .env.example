# Copiez ce fichier en « .env » et renseignez vos identifiants.
# .env n'est jamais envoyé sur GitHub (voir .gitignore).
# Sur GitHub Actions, créez les mêmes noms dans Settings → Secrets and variables → Actions.

# ACLED (licence requise) – activer la source "acled" dans config/sources.json
ACLED_EMAIL=
ACLED_PASSWORD=

# Exemple : fournisseur d'alertes payant (connecteur "jsonapi")
FOURNISSEUR_TOKEN=

# Exemple : flux presse réservé aux abonnés (cookie de session, format nom=valeur; nom2=valeur2)
PRESSE_ABONNE_COOKIE=

# IA (classement, lieu, résumé en anglais des titres de presse) – https://console.anthropic.com
# Activez un plafond de dépenses sur la console. Budget mensuel interne : config/settings.json → ai.monthly_budget_usd
ANTHROPIC_API_KEY=

# ReliefWeb (ONU OCHA) – nom d'application gratuit à demander sur https://apidoc.reliefweb.int
RELIEFWEB_APPNAME=

# Alertes Telegram (bot créé avec @BotFather ; chat_id obtenu via https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertes e-mail (ex. Gmail : smtp.gmail.com, port 587, « mot de passe d'application »)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
